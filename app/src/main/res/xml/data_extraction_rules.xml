<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The DataStore holds the panel API key (long-lived admin JWT); keep it off the wire. -->
    <cloud-backup>
        <exclude domain="file" path="settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
